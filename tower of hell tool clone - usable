local plrs = game:GetService("Players")
local plr = plrs.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local rps = game:GetService("ReplicatedStorage")
local gearfolder = rps.Assets.Gear

if gearfolder then 
print("Found gear folder")

for _, gear in pairs(gearfolder:GetChildren()) do 
print("gear found" .. gear.Name)

end
local fusion = gearfolder:FindFirstChild("fusion")

if fusion then
print("found fusion")

local clonedf = fusion:Clone()
clonedf.Parent = plr.Backpack
else
print("no fusion found") 
end

else 
warn("No gear found")
end


